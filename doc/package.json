{
  "name": "thp-documentation",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsx src/cli.ts build && pagefind --site dist",
    "check": "tsc --noEmit && vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2",
    "pagefind": "^1.5.2",
    "shiki": "^3.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11"
  }
}
